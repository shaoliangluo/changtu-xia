{
  "manifest_version": 3,
  "name": "长图侠",
  "version": "1.2.1",
  "description": "整页长图、当前屏幕或框选范围。不读取浏览记录，不注入广告。",
  "minimum_chrome_version": "116",
  "browser_specific_settings": {
    "gecko": {
      "id": "jietuchangtu@local.extension",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_title": "长图侠",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  }
}
